# Copy to .env and edit. `docker compose` / `podman compose` read this file automatically.

# Login credentials for the dashboard
DASH_USER=admin
DASH_PASSWORD=change-me

# Port nginx listens on (host side)
DASH_PORT=8080

# Optional: fixed secret for signing session cookies. If unset one is generated
# and stored in ./data/secret on first run.
# SESSION_SECRET=

# ---- Docker widget: container engine socket ----
# Docker (default):
CONTAINER_SOCKET=/var/run/docker.sock

# Podman, rootful:   sudo systemctl enable --now podman.socket
# CONTAINER_SOCKET=/run/podman/podman.sock

# Podman, rootless:  systemctl --user enable --now podman.socket
# CONTAINER_SOCKET=/run/user/1000/podman/podman.sock   # use your uid: id -u

# Timezone for event times / logs
TZ=Europe/London

# ---- Reaching services that run on the same machine as the dashboard ----
# Typing "localhost" or "127.0.0.1" in a widget URL is rewritten to HOST_ALIAS,
# because inside the container localhost is the container itself.
# Linux (Docker or Podman): the default works.
# HOST_ALIAS=host.docker.internal
# Podman Desktop on Windows/macOS: host.docker.internal is the podman VM, not your
# PC. Use your PC's LAN IP (ipconfig / ifconfig) - and make sure the service
# listens on 0.0.0.0, not 127.0.0.1.
# HOST_ALIAS=192.168.1.141

# Optional GitHub token (fine-grained, read-only) so github.com bookmarks can show
# stars / issues / commits without hitting the anonymous rate limit.
# GITHUB_TOKEN=github_pat_...

# Accept self-signed HTTPS certificates on the services you add (Proxmox, TrueNAS, UniFi...).
# ALLOW_SELF_SIGNED=false
